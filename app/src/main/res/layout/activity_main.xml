<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/app_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
        android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_ui_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textStyle="bold" android:textSize="26sp" android:textColor="@color/app_text"/>
            <ImageView android:id="@+id/mainMore" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:src="@drawable/ic_ui_more" android:clickable="true" android:focusable="true"
                android:contentDescription="@string/ui_more" />
        </LinearLayout>
        <TextView android:id="@+id/mainSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="@string/ui_home_subtitle" android:textColor="@color/ui_muted" android:textSize="14sp"/>
        <ImageView android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="12dp"
            android:src="@drawable/ic_ui_camera" android:contentDescription="@null"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/camerasSection" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/mainScan" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:gravity="center_vertical"
                    android:padding="14dp" android:orientation="horizontal" android:background="@drawable/bg_ui_card" android:clickable="true" android:focusable="true"
                    android:contentDescription="@string/buscar_cameras">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_ui_search" android:contentDescription="@null"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                        android:text="@string/ui_search" android:textStyle="bold" android:textColor="@color/app_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/mainAdd" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="5dp" android:gravity="center_vertical"
                    android:padding="14dp" android:orientation="horizontal" android:background="@drawable/bg_ui_card" android:clickable="true" android:focusable="true"
                    android:contentDescription="@string/nova_camera">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_ui_plus" android:contentDescription="@null"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                        android:text="@string/ui_add" android:textStyle="bold" android:textColor="@color/app_text"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/minhas_cameras"
                android:textColor="@color/app_text" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="18dp" android:layout_marginBottom="6dp"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:divider="@android:color/transparent" android:dividerHeight="6dp" android:clipToPadding="false" android:paddingBottom="12dp" />
                <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:text="@string/ui_empty_cameras"
                    android:textColor="@color/ui_muted"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/phoneSection" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_phone_title"
                android:textColor="@color/app_text" android:textStyle="bold" android:textSize="19sp" android:layout_marginBottom="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/roleTransmit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:background="@drawable/bg_ui_card" android:padding="13dp" android:orientation="vertical"
                    android:clickable="true" android:focusable="true" android:contentDescription="@string/phone_role_transmit">
                    <ImageView android:layout_width="match_parent" android:layout_height="78dp" android:padding="22dp"
                        android:background="@drawable/bg_ui_selected" android:src="@drawable/ic_ui_tower" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp"
                        android:text="@string/phone_role_transmit" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/app_text"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="@string/ui_transmit_desc" android:textSize="13sp" android:textColor="@color/ui_muted"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/roleAssistir" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:background="@drawable/bg_ui_card" android:padding="13dp" android:orientation="vertical"
                    android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_assist">
                    <ImageView android:layout_width="match_parent" android:layout_height="78dp" android:padding="22dp"
                        android:background="@drawable/bg_ui_selected" android:src="@drawable/ic_ui_scan" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp"
                        android:text="@string/ui_assist" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/app_text"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="@string/ui_assist_desc" android:textSize="13sp" android:textColor="@color/ui_muted"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/phoneManual" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:padding="10dp" android:clickable="true" android:focusable="true"
                android:text="@string/ui_manual_link" android:textColor="@color/brand_primary"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_saved_phones"
                android:textColor="@color/app_text" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ListView android:id="@+id/phoneSavedList" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:divider="@android:color/transparent" android:dividerHeight="6dp" android:clipToPadding="false" android:paddingBottom="12dp" />
                <TextView android:id="@+id/phoneEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:padding="16dp" android:text="@string/ui_empty_phones"
                    android:textColor="@color/ui_muted"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="14dp" android:paddingTop="10dp">
        <LinearLayout android:id="@+id/mainTabCameras" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp"
            android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_ui_selected"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_tab_cameras">
            <ImageView android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_ui_cctv" android:contentDescription="@null"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tab_cameras"
                android:layout_marginTop="5dp" android:textColor="@color/app_text" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/mainTabPhone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp"
            android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_ui_card"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_tab_phone">
            <ImageView android:layout_width="27dp" android:layout_height="27dp" android:src="@drawable/ic_ui_smartphone" android:contentDescription="@null"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_tab_phone"
                android:layout_marginTop="5dp" android:textColor="@color/app_text" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
