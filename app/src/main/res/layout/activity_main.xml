<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/app_background">

  <LinearLayout
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="18dp" android:layout_margin="12dp"
      android:background="@drawable/bg_ui_hero">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
      <ImageView android:layout_width="50dp" android:layout_height="50dp" android:padding="10dp"
          android:src="@drawable/ic_ui_camera" android:background="@drawable/bg_ui_chip_light"
          android:contentDescription="@null"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="27sp" android:textStyle="bold"
            android:textColor="@color/player_text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Suas câmeras e celulares em um só lugar"
            android:textSize="13sp" android:textColor="@color/player_muted"/>
      </LinearLayout>
      <ImageView android:id="@+id/mainMore" android:layout_width="48dp" android:layout_height="48dp"
          android:padding="12dp" android:src="@drawable/ic_ui_settings" android:tint="@color/player_text"
          android:background="@drawable/bg_ui_chip_light" android:clickable="true" android:focusable="true"
          android:contentDescription="@string/home_settings"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="Rede local" android:textColor="@color/player_text" android:textStyle="bold"
          android:textSize="12sp" android:background="@drawable/bg_ui_chip_light"
          android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginStart="8dp" android:text="Sem nuvem obrigatória"
          android:textColor="@color/player_text" android:textStyle="bold" android:textSize="12sp"
          android:background="@drawable/bg_ui_chip_light"
          android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="2">
      <LinearLayout android:id="@+id/roleTransmit" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:minHeight="118dp" android:padding="16dp"
          android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_ui_chip_light"
          android:clickable="true" android:focusable="true" android:layout_marginEnd="6dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_tower"
            android:tint="@color/player_text" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_transmit" android:textStyle="bold" android:textColor="@color/player_text"
            android:textSize="18sp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Usar este celular como câmera" android:textColor="@color/player_muted"
            android:textSize="12sp" android:layout_marginTop="4dp" android:gravity="center"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/roleAssistir" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:minHeight="118dp" android:padding="16dp"
          android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_ui_chip_light"
          android:clickable="true" android:focusable="true" android:layout_marginStart="6dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_scan"
            android:tint="@color/player_text" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_watch" android:textStyle="bold" android:textColor="@color/player_text"
            android:textSize="18sp" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Abrir câmera ou celular da rede" android:textColor="@color/player_muted"
            android:textSize="12sp" android:layout_marginTop="4dp" android:gravity="center"/>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:paddingHorizontal="16dp" android:orientation="horizontal" android:gravity="center_vertical">
    <Button android:id="@+id/mainScan" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="50dp" android:text="@string/ui_search" android:textAllCaps="false"/>
    <Button android:id="@+id/mainAdd" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="50dp" android:layout_marginStart="6dp" android:text="@string/ui_add" android:textAllCaps="false"/>
    <Button android:id="@+id/phoneManual" android:layout_width="0dp" android:layout_weight="1.25"
        android:layout_height="50dp" android:layout_marginStart="6dp" android:text="@string/ui_manual_link"
        android:textSize="10sp" android:textAllCaps="false"/>
  </LinearLayout>

  <LinearLayout android:id="@+id/mainMedia" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:gravity="center_vertical" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
      android:padding="16dp" android:background="@drawable/bg_ui_card" android:orientation="horizontal">
    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ui_gallery"
        android:contentDescription="@null"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="@string/home_multimedia" android:textColor="@color/app_text" android:textStyle="bold" android:textSize="18sp"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="Fotos, vídeos, gravações locais e do outro celular"
          android:textColor="@color/ui_muted" android:textSize="12sp"/>
    </LinearLayout>
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_ui_expand" android:contentDescription="@null"/>
  </LinearLayout>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginStart="18dp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp"
      android:text="@string/home_all" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/app_text"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginBottom="4dp"
      android:text="Câmeras IP e celulares encontrados ou adicionados manualmente." android:textSize="13sp" android:textColor="@color/ui_muted"/>

  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
        android:divider="@android:color/transparent" android:dividerHeight="2dp" android:paddingBottom="24dp" android:clipToPadding="false"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:padding="20dp" android:gravity="center"
        android:text="@string/ui_empty_cameras" android:textColor="@color/ui_muted"/>
  </FrameLayout>
</LinearLayout>
