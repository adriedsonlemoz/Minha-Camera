                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="MP4" android:textColor="@color/app_text" android:textSize="10sp"/>
                <TextView android:id="@+id/valuePhoneStorage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="15 FPS" android:textColor="@color/brand_primary" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneDiagnosticCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="66dp" android:layout_marginStart="3dp" android:padding="3dp" android:gravity="center" android:background="@drawable/bg_tx_tile_compact" android:orientation="vertical" android:clickable="true" android:focusable="true">
