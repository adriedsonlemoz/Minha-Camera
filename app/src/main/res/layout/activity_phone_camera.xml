                <TextView android:id="@+id/labelphoneQr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/ui_qr" android:textColor="@color/app_text" android:textSize="10sp"/>
