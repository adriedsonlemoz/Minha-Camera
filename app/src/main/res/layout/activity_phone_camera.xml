                <TextView android:id="@+id/valuePhoneDiagnostic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Abrir" android:textColor="@color/brand_primary" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <View android:id="@+id/phoneRevoke" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
