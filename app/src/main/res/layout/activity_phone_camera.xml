<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/app_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/ui_live" android:textColor="@color/app_text" android:textSize="23sp" android:textStyle="bold"/>
            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_ui_live"/>
            <TextView android:id="@+id/phoneStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/phone_waiting" android:textColor="@color/brand_secondary" android:layout_marginStart="7dp" android:textSize="13sp"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/phoneSinglePreview" android:layout_width="match_parent" android:layout_height="240dp"
            android:background="@drawable/bg_ui_preview" android:clipToOutline="true">
            <TextureView android:id="@+id/phonePreview" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <ImageView android:id="@+id/phoneBackgroundPreview"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:background="#000000"
                android:visibility="gone" android:contentDescription="@string/phone_camera" />
            <TextView android:id="@+id/phoneTelemetryPreview"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_margin="10dp"
                android:background="@drawable/bg_phone_telemetry" android:paddingStart="9dp"
                android:paddingEnd="9dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFFFF"
                android:visibility="gone" android:contentDescription="@string/phone_battery_overlay_description" />
            <TextView android:id="@+id/previewPlaceholder" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="@string/ui_preview_loading" android:textColor="#C4CCD7" android:textSize="14sp"/>
        </FrameLayout>
        <LinearLayout android:id="@+id/phoneDualPreview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
            android:background="@drawable/bg_ui_preview" android:padding="5dp">
            <ImageView android:id="@+id/phoneDualTop" android:layout_width="match_parent"
                android:layout_height="200dp" android:scaleType="fitCenter" android:background="#2B4756"
                android:contentDescription="@string/phone_back_camera" />
            <ImageView android:id="@+id/phoneDualBottom" android:layout_width="match_parent"
                android:layout_height="200dp" android:layout_marginTop="5dp" android:scaleType="fitCenter"
                android:background="#4B4255" android:contentDescription="@string/phone_front_camera" />
        </LinearLayout>
        <TextView android:id="@+id/phoneTxPerformance"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:paddingTop="5dp"
            android:text="@string/phone_performance_waiting"
            android:textColor="@color/ui_muted" android:textSize="12sp" />
        <TextView android:id="@+id/phoneThermalWarning"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:padding="7dp"
            android:background="@drawable/bg_phone_telemetry"
            android:textColor="#FFFFFFFF" android:textSize="12sp"
            android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/phoneSwitch" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="0dp"
                android:layout_marginEnd="3dp" android:padding="4dp" android:gravity="center"
                android:background="@drawable/bg_ui_card" android:orientation="vertical" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/ui_flip">
                <ImageView android:id="@+id/iconphoneSwitch"
                    android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_flip"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/labelphoneSwitch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/ui_flip" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneDual" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" android:padding="4dp" android:gravity="center"
                android:background="@drawable/bg_ui_card" android:orientation="vertical" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/ui_dual">
                <ImageView android:id="@+id/iconphoneDual"
                    android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_dual"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/labelphoneDual"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/ui_dual" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneQr" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" android:padding="4dp" android:gravity="center"
                android:background="@drawable/bg_ui_card" android:orientation="vertical" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/ui_qr">
                <ImageView android:id="@+id/iconphoneQr"
                    android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_qr"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/labelphoneQr"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/ui_qr" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneRecord" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp" android:padding="4dp" android:gravity="center"
                android:background="@drawable/bg_ui_card" android:orientation="vertical" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/ui_record">
                <ImageView android:id="@+id/phoneRecordIcon"
                    android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_record"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/phoneRecordLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/ui_record" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/phoneMore" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="3dp"
                android:layout_marginEnd="0dp" android:padding="4dp" android:gravity="center"
                android:background="@drawable/bg_ui_card" android:orientation="vertical" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/ui_more_short">
                <ImageView android:id="@+id/iconphoneMore"
                    android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_more"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/labelphoneMore"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/ui_more_short" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- A ação Código fica em Mais, preservando ID para o fluxo de confirmação existente. -->
        <View android:id="@+id/phoneRevoke" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/ui_stream_instructions" android:textColor="@color/ui_muted" android:textSize="13sp"/>
        <TextView android:id="@+id/phoneAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:text="@string/phone_no_address"/>
    </LinearLayout>
</ScrollView>
