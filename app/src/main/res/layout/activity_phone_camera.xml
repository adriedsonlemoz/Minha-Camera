            <TextView android:id="@+id/phoneTransmissionPause" android:layout_width="85dp" android:layout_height="40dp" android:gravity="center" android:padding="3dp" android:text="Ⅱ Pausar" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/bg_phone_telemetry" android:clickable="true" android:focusable="true" android:contentDescription="Ⅱ Pausar" android:layout_marginStart="5dp" android:visibility="gone"/></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="5dp"><TextView android:id="@+id/phoneTxPerformance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:background="@drawable/bg_phone_telemetry" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/phone_performance_waiting" android:textColor="#FFFFFFFF" android:textSize="11sp" android:padding="5dp"/>
            <TextView android:id="@+id/phoneTransmissionClock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_phone_telemetry" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/phone_clock_idle" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="11sp" android:layout_marginStart="5dp" android:padding="5dp"/>
                </LinearLayout></LinearLayout></FrameLayout><TextView android:id="@+id/phoneThermalWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="9dp" android:background="@drawable/bg_phone_telemetry" android:textColor="#FFFFFFFF" android:textSize="12sp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Controles e ajustes" android:textColor="@color/app_text" android:textStyle="bold" android:textSize="18sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tudo visível na tela para usar como retrovisor ou câmera de monitoramento." android:textColor="@color/ui_muted" android:textSize="13sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/phoneSwitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="66dp" android:layout_marginEnd="3dp" android:padding="3dp" android:gravity="center" android:background="@drawable/bg_tx_tile_compact" android:orientation="vertical" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_flip">
