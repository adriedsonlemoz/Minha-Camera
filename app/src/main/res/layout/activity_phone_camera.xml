<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/app_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/phone_camera_instructions" android:textColor="@color/app_text"
            android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/phoneStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/phone_waiting"
            android:gravity="center" android:textStyle="bold" android:textColor="@color/app_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/phone_preview_label" android:textColor="@color/app_text"
            android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="260dp"
            android:background="#000000">
            <TextureView android:id="@+id/phonePreview" android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/phone_pairing_label" android:textColor="@color/app_text"
            android:gravity="center" android:layout_marginTop="16dp" />
        <ImageView android:id="@+id/phoneQrCode" android:layout_width="224dp"
            android:layout_height="224dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
            android:padding="8dp" android:background="#FFFFFF"
            android:scaleType="fitCenter" android:visibility="gone"
            android:contentDescription="@string/phone_qr_code_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/phone_qr_hint" android:textColor="@color/app_text"
            android:gravity="center" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/phoneAddress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/phone_no_address"
            android:textIsSelectable="true" android:layout_marginTop="8dp"
            android:textSize="12sp" android:textColor="@color/app_text"
            android:breakStrategy="simple" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/phoneSwitch" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/phone_switch" />
            <Button android:id="@+id/phoneCopy" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/phone_copy" />
        </LinearLayout>
        <Button android:id="@+id/phoneShare" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/phone_share" />
        <Button android:id="@+id/phoneRevoke" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/phone_revoke" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/phone_security_notice"
            android:textColor="@color/app_text" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
