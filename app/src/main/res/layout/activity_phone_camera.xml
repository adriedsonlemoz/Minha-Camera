                <TextView android:id="@+id/valuePhoneSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Traseira" android:textColor="@color/brand_primary" android:textSize="10sp"/>
