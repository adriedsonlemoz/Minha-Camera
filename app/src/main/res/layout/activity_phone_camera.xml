            <LinearLayout android:id="@+id/phoneRecord" android:layout_width="0dp" android:layout_weight="1" android:layout_height="66dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:padding="3dp" android:gravity="center" android:background="@drawable/bg_tx_tile_compact" android:orientation="vertical" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_record">
