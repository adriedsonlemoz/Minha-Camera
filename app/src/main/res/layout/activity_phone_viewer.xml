<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:id="@+id/phoneViewerScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/player_background" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/ui_live" android:textColor="@color/app_text"
                android:textSize="23sp" android:textStyle="bold"/>
            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_ui_live"/>
            <TextView
                android:id="@+id/phoneViewerStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:text="@string/phone_connecting"
                android:textColor="@color/brand_secondary" android:textSize="13sp"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/phoneViewerPreviewContainer"
            android:layout_width="match_parent" android:layout_height="240dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_ui_preview"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/phoneImage" android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="#000000" android:contentDescription="@string/phone_camera"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/phoneViewerTelemetry" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="top|start"
                android:layout_margin="10dp" android:background="@drawable/bg_phone_telemetry"
                android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="6dp"
                android:paddingBottom="6dp" android:textColor="#FFFFFFFF" android:textSize="12sp"
                android:textStyle="bold" android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/phoneViewerPerformance" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="end" android:paddingTop="6dp"
            android:text="@string/phone_performance_waiting" android:textColor="@color/ui_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/phoneViewerTelemetryDetails" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:padding="8dp"
            android:background="@drawable/bg_phone_telemetry" android:text="@string/phone_receiver_waiting_telemetry"
            android:textColor="#FFFFFFFF" android:textSize="12sp" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/phoneViewerControls"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/phoneRetry" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginEnd="4dp" android:padding="4dp"
                android:gravity="center" android:background="@drawable/bg_ui_card" android:orientation="vertical"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/tentar_novamente">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_scan"
                    android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/phone_view_retry_short" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phoneViewerFit" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:padding="4dp"
                android:gravity="center" android:background="@drawable/bg_ui_card" android:orientation="vertical"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/imagem_inteira">
                <ImageView android:id="@+id/phoneViewerFitIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_fit"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/phoneViewerFitLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/phone_view_fit" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/phoneViewerMirror" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:padding="4dp"
                android:gravity="center" android:background="@drawable/bg_ui_card" android:orientation="vertical"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/phone_view_mirror">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_mirror"
                    android:contentDescription="@null"/>
                <TextView android:id="@+id/phoneViewerMirrorLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/phone_view_mirror" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phoneViewerFocus" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:padding="4dp"
                android:gravity="center" android:background="@drawable/bg_ui_card" android:orientation="vertical"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/phone_view_focus">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_fullscreen"
                    android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/phone_view_focus" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phoneViewerMore" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="76dp" android:layout_marginStart="4dp" android:padding="4dp"
                android:gravity="center" android:background="@drawable/bg_ui_card" android:orientation="vertical"
                android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_more_short">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ui_more"
                    android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="@string/ui_more_short" android:textColor="@color/app_text" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/phoneViewerInstructions"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/phone_receiver_instructions" android:textColor="@color/ui_muted" android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>
<FrameLayout android:id="@+id/phoneViewerPipHost"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:visibility="gone" />
</FrameLayout>
