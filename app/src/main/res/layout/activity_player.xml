<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/player_background">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/playerToolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/player_panel" app:titleTextColor="@color/player_text" app:subtitleTextColor="@color/player_muted" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/player_text" />
 <FrameLayout android:id="@+id/videoViewport" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="true" android:clipToPadding="true" android:background="#000000">
  <FrameLayout android:id="@+id/videoClip" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:clipChildren="true" android:clipToPadding="true">
  <FrameLayout android:id="@+id/videoContainer" android:layout_width="match_parent" android:layout_height="match_parent">
   <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" app:resize_mode="fit" app:use_controller="false" />
   <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlcView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
  </FrameLayout>
  </FrameLayout>
  <TextView android:id="@+id/engineText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="12dp" android:background="@drawable/player_badge" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/live_accent" android:textStyle="bold" android:textSize="12sp" />
  <TextView android:id="@+id/recordTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="12dp" android:background="@drawable/player_badge" android:padding="10dp" android:textColor="#FFAAA7" android:textStyle="bold" android:visibility="gone" />
  <LinearLayout android:id="@+id/loadingBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="24dp" android:background="@drawable/player_badge" android:padding="24dp" android:orientation="vertical" android:gravity="center">
   <ProgressBar android:id="@+id/progress" android:layout_width="40dp" android:layout_height="40dp" android:indeterminateTint="@color/live_accent" />
   <TextView android:id="@+id/loadingTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/carregando_imagem" android:textColor="@color/player_text" android:textSize="16sp" android:textStyle="bold" android:gravity="center" />
   <TextView android:id="@+id/loadingDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/aguarde_imagem" android:textColor="@color/player_muted" android:textSize="13sp" android:gravity="center" />
  </LinearLayout>
  <LinearLayout android:id="@+id/errorBox" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:background="@color/player_background" android:visibility="gone">
   <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/player_text" android:textSize="16sp" />
   <com.google.android.material.button.MaterialButton android:id="@+id/btnRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/tentar_novamente" />
   <ScrollView android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="12dp"><TextView android:id="@+id/errorDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/player_muted" android:textSize="11sp" /></ScrollView>
  </LinearLayout>
 </FrameLayout>
 <include layout="@layout/player_controls" />
</LinearLayout>